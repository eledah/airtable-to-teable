# Copy to .env (or export in your shell). Never commit real tokens.
# Airtable personal access token (https://airtable.com/create/tokens)
AIRTABLE_TOKEN=pat...

# Teable personal access token (Teable -> avatar -> Access Token)
TEABLE_TOKEN=

# Teable server base URL (self-hosted). Examples:
#   http://localhost:3000        (local docker default)
#   https://teable.your-domain   (production)
TEABLE_API_URL=http://localhost:3000

# Local backup root produced by `download` and consumed by `import`/`attach`
BACKUP_DIR=./backup
